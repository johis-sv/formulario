# ─── Supabase ────────────────────────────────────────────────────────────────
# Obten estas variables desde: https://app.supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# ─── Resend (emails) ──────────────────────────────────────────────────────────
# Obten tu API Key desde: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# ─── Email remitente ─────────────────────────────────────────────────────────
# Debe ser un correo de tu dominio verificado en Resend
# Si aún no tienes dominio verificado, usa: onboarding@resend.dev (solo para pruebas)
EMAIL_FROM=innovacion@tuempresa.com
EMAIL_REPLY_TO=innovacion@tuempresa.com
